# YegnaBet Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
# Local MongoDB (for development)
# MONGODB_URI=mongodb://localhost:27017/yegnabet

# MongoDB Atlas (replace with your connection string)
MONGODB_URI=mongodb+srv://yegnabet-admin:<uemI8j1U4EFA58cP>@yegnabet-cluster.hstz9bv.mongodb.net/?appName=yegnabet-cluster

# Test database
MONGODB_TEST_URI=mongodb+srv://yegnabet-admin:<uemI8j1U4EFA58cP>@yegnabet-cluster.xxxxx.mongodb.net/yegnabet_test?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_secure
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Configuration (Gmail/SendGrid/Ethiopian Email Service)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@yegnabet.com

# Cloudinary Configuration (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Ethiopian Payment Gateway Configuration
# (Ready for integration with Ethiopian banks/mobile money)
PAYMENT_GATEWAY_URL=https://api.ethiopianbank.com
PAYMENT_GATEWAY_KEY=your_payment_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

# CBE Birr (Commercial Bank of Ethiopia)
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_API_KEY=your_cbe_api_key

# Telebirr Integration
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_key

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Ethiopian Business Configuration
DEFAULT_CURRENCY=ETB
DEFAULT_TIMEZONE=Africa/Addis_Ababa
DEFAULT_LANGUAGE=en

# Admin Configuration
ADMIN_EMAIL=admin@yegnabet.com
SUPER_ADMIN_PASSWORD=change_this_password_immediately